# Voice Education Assistant — environment variable template
#
# Copy to .env and fill in real values locally:
#     cp .env.example .env
#
# .env is gitignored. NEVER commit real secrets.

# --- N-ATLaS ASR ---
# Filled in once we confirm the official access method.
# N_ATLAS_ASR_ENDPOINT=
# N_ATLAS_ASR_API_KEY=

# --- N-ATLaS LLM ---
# Filled in once we confirm the official access method.
# N_ATLAS_LLM_ENDPOINT=
# N_ATLAS_LLM_API_KEY=

# --- TTS ---
# Provider TBD.
# TTS_PROVIDER=
# TTS_API_KEY=

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
